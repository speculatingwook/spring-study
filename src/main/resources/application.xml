<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="xmlbean" class="speculatingwook.spring.bean_xml.XmlBean">
        <constructor-arg index="0" value="xml bean1"/>
        <constructor-arg index="1" value="1234"/>
    </bean>

    <bean id="dependencybean" class="speculatingwook.spring.bean_xml.DependencyBean">
        <constructor-arg index="0" ref="xmlbean"/>
        <constructor-arg index="1" value="dependency bean1"/>
        <constructor-arg index="2" value="5678"/>
    </bean>

</beans>